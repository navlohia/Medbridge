# MedBridge Backend Environment Variables
# Copy to .env and fill in. Never commit the real .env.

# Google Gemini API key — enables AI-generated plain-language medicine
# explanations at seed time. If empty, MedBridge falls back to static
# verified clinical uses without any errors.
GEMINI_API_KEY=

PORT=5000

# JWT signing secret. Do NOT ship the old public example value — if this is
# missing (or still the old public default) the server generates a random
# 48-byte secret into .env at startup and logs that it did.
JWT_SECRET=

# P11 (A2): doctor self sign-up gate. Doctor registration requires this code;
# leave EMPTY to disable doctor self sign-up entirely.
# Demo value used in this project: CLINIC-2026-DEMO
CLINIC_ACCESS_CODE=

# P12 (A3): one-time admin bootstrap. Only usable while the database has ZERO
# admin accounts; ignored afterwards.
# Demo value used in this project: ADMIN-BOOTSTRAP-2026
ADMIN_INVITE_CODE=

# P37: comma-separated CORS allowlist (defaults shown).
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5000
